{
    "version": "2.0.0",
    "tasks": [
        {
            "label": "Build distribution (zip + deploy)",
            "type": "process",
            "command": "${workspaceFolder}/.venv/Scripts/python.exe",
            "args": ["build_dist.py"],
            "options": { "cwd": "${workspaceFolder}" },
            "group": { "kind": "build", "isDefault": true },
            "presentation": { "reveal": "always", "panel": "dedicated", "clear": true },
            "problemMatcher": []
        },
        {
            "label": "Tests",
            "type": "process",
            "command": "${workspaceFolder}/.venv/Scripts/python.exe",
            "args": ["-m", "pytest", "-q"],
            "options": { "cwd": "${workspaceFolder}" },
            "group": "test",
            "problemMatcher": []
        }
    ]
}
