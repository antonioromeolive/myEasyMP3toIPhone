# myEasyMP3toIPhone: le variabili che il programma legge. Questo file si legge a ogni avvio.
# (È il modello distribuito con il programma: la tua copia, con i tuoi valori, è
#  %USERPROFILE%\.myEasyMP3toIPhone\myEasyMP3toIPhone.env. Non scrivere valori in questo modello.)
#
# Cosa vuol dire ogni riga (riavvia il programma dopo una modifica):
#   NOME=valore    si usa questo valore, anche se il sistema ne ha un altro per NOME
#   NOME=$ALTRA    il valore di ALTRA: da questo file se qui ne ha uno, altrimenti dal sistema
#   NOME=          il valore di NOME nel sistema; nessuno se il sistema non ne ha (come NOME=$NOME)
# Scrivi i valori senza virgolette. Un valore che inizia davvero con $ si scrive con $$ all'inizio.
# Niente commenti in fondo alla riga: una chiave può contenere #.
#
# - Le chiavi sono segreti scritti in chiaro: tieni privato questo file, non condividerlo e non metterlo in git.
#   Se la cartella dati è in una cartella sincronizzata (OneDrive...), le chiavi vengono sincronizzate con lei.
# - In alternativa una chiave si scrive nelle Impostazioni del programma: va nella Gestione credenziali di Windows.
#   Nelle Impostazioni un campo scritto $NOME legge la variabile NOME (da questo file o dal sistema).
# - Una variabile che le tue Impostazioni nominano ($NOME) viene aggiunta qui al prossimo avvio, vuota: solo il nome.
# - La cartella dati non si sceglie qui: usa la variabile di sistema MYEASYMP3TOIPHONE_HOME.
# - Informazioni… nel programma dice per ogni variabile se viene da questo file o dal sistema.

# --- Il log (myEasyMP3toIPhone.log nella cartella dati): DEBUG, INFO, WARNING, ERROR. Vuota = INFO
MYEASYMP3TOIPHONE_LOG_LEVEL=

# I nomi sono gli stessi di myCalibreTools: se le variabili sono già nel sistema per quel programma, lascia vuote le
# righe (vale il sistema). Un profilo AI nuovo nomina da solo le variabili del suo tipo che hanno un valore.

# --- Ollama: i profili Ollama ($OLLAMA_API_BASE, $OLLAMA_API_KEY)
# OLLAMA_API_BASE è il server, nessun valore = http://localhost:11434
# OLLAMA_API_KEY serve solo per un server che la chiede (ollama.com, un server dietro un proxy)
# OLLAMA_FALLBACK_API_BASE è un secondo server, per esempio https://ollama.com, per i profili che lo nominano
OLLAMA_API_BASE=
OLLAMA_API_KEY=
OLLAMA_FALLBACK_API_BASE=

# --- Azure OpenAI / Azure AI Foundry: i profili Azure ($AZURE_FOUNDRY_EP, $AZURE_FOUNDRY_KEY)
# Esempio di endpoint: https://la-tua-risorsa.openai.azure.com
AZURE_FOUNDRY_EP=
AZURE_FOUNDRY_KEY=

# --- OpenAI: i profili OpenAI ($OPENAI_API_KEY)
OPENAI_API_KEY=

# --- Anthropic (Claude): i profili Anthropic ($ANTHROPIC_API_KEY)
ANTHROPIC_API_KEY=

# --- myCalibreTools: dove sono i suoi profili AI, per "Importa da myCalibreTools" nelle Impostazioni.
# Nessun valore = %USERPROFILE%\.myCalibreTools
MYCALIBRETOOLS_HOME=
